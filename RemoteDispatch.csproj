<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>CSARemoteDispatch</AssemblyName>
    <RootNamespace>DvMod.RemoteDispatch</RootNamespace>
    <InformationalVersion>1.4.5</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1"/>
    <Publicize Include="Assembly-CSharp" IncludeCompilerGeneratedMembers="false"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"/>
    <Reference Include="DV.BrakeSystem"/>
    <Reference Include="DV.Simulation"/>
    <Reference Include="DV.Common"/>
    <Reference Include="DV.Interaction"/>
    <Reference Include="DV.PointSet"/>
    <Reference Include="BezierCurves"/>
    <Reference Include="DV.RailTrack" />
    <Reference Include="DV.SignPlacer"/>
    <Reference Include="DV.ThingTypes"/>
    <Reference Include="DV.Utils"/>
    <Reference Include="Microsoft.CSharp"/>
    <Reference Include="Newtonsoft.Json"/>
    <Reference Include="net.smkd.vector3d"/>
    <Reference Include="WorldStreamer" />
    <!-- Optional at runtime: RouteNetwork checks Unity Mod Manager before any
         Multiplayer API type is resolved. -->
    <Reference Include="MultiplayerAPI">
      <HintPath>$(DvInstallDir)\Mods\Multiplayer\MultiplayerAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Signals.Common">
      <HintPath>$(DvInstallDir)\Mods\DVSignals\Signals.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Signals.Game">
      <HintPath>$(DvInstallDir)\Mods\DVSignals\Signals.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"/>
    <Reference Include="UnityEngine.IMGUIModule"/>
    <Reference Include="UnityEngine.InputLegacyModule"/>
    <Reference Include="UnityEngine.PhysicsModule"/>
    <Reference Include="UnityEngine.TextRenderingModule"/>
    <PackageReference Include="UnityModManager" Version="0.27.2"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.svg"/>
    <EmbeddedResource Include="index.html"/>
    <EmbeddedResource Include="leaflet.rotatedImageOverlay.js"/>
    <EmbeddedResource Include="licenses/*.png"/>
    <EmbeddedResource Include="main.js"/>
    <EmbeddedResource Include="style.css"/>
  </ItemGroup>
</Project>
